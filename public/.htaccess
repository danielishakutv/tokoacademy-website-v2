# Toko Academy — Apache configuration for the static site.
#
# This file is deployed with the site, so it is version controlled and a bad
# change is revertible. It replaces a WP Fastest Cache .htaccess left behind
# from when tokoacademy.org was WordPress, which was doing real damage:
#
#   Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
#   Header set Expires "Mon, 29 Oct 1923 20:30:00 GMT"
#
# Applied to every index.html — which, in a static export, is every page on
# the site. Cloudflare therefore cached nothing (cf-cache-status: DYNAMIC) and
# every visit travelled to this origin: a 755ms server response on a site whose
# audience is on mobile data in the North East. `no-store` also disqualified
# every page from the browser's back/forward cache, so going Back re-downloaded
# the page instead of restoring it instantly.
#
# Two facts about this server shape everything below:
#
#   * mod_expires is NOT loaded — only mod_deflate and mod_headers. Every
#     ExpiresByType line in the old file was silently ignored, which is why a
#     malformed `Header set Expires "max-age=A10368000, public"` was the only
#     thing taking effect. Caching here is done with Cache-Control alone.
#   * The site sits behind Cloudflare. s-maxage is what Cloudflare reads;
#     max-age is what the browser reads. They are set separately on purpose.

# ── Errors ──────────────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Compression ─────────────────────────────────────────────────────────────
# Cloudflare compresses what it serves, but a cache MISS is fetched from here,
# and these bytes cross the network either way.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

<IfModule mod_headers.c>
  # ── Build output: content-hashed, therefore immutable ────────────────────
  #
  # Next puts a hash in the filename of everything under /_next/static, so a
  # changed file is a different URL and a cached one can never be stale. A year
  # with `immutable` means a returning visitor re-downloads none of it — which
  # on a slow connection is the difference between a page that appears and a
  # page that loads.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Expires
    Header unset Pragma
  </If>

  # ── The service worker: never cache ─────────────────────────────────────
  #
  # sw.js has no hash in its name and is the one file that decides how
  # everything else is cached. A stale copy of it pins a stale copy of the
  # site, which is exactly the bug this whole change is here to undo.
  <Files "sw.js">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header unset Expires
    Header unset Pragma
  </Files>

  # ── Images, fonts and media ─────────────────────────────────────────────
  #
  # Not content-hashed, so a month rather than a year: long enough to help a
  # returning visitor, short enough that replacing a photograph reaches people
  # without anybody clearing anything.
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|eot|mp4|webm|ogg)$">
    Header set Cache-Control "public, max-age=2592000"
    Header unset Expires
    Header unset Pragma
  </FilesMatch>

  # ── Files that must stay current ────────────────────────────────────────
  <FilesMatch "^(robots\.txt|sitemap\.xml|site\.webmanifest|llms\.txt)$">
    Header set Cache-Control "public, max-age=3600"
    Header unset Expires
    Header unset Pragma
  </FilesMatch>

  # ── Pages ───────────────────────────────────────────────────────────────
  #
  # max-age=0 so a returning visitor always revalidates and sees a fresh
  # deploy immediately. s-maxage=600 so Cloudflare answers from its own edge
  # for ten minutes instead of crossing a continent. stale-while-revalidate
  # lets it serve the cached copy instantly while fetching a new one behind
  # the scenes, so nobody waits for the refresh.
  #
  # Crucially this is not `no-store`, so pages are eligible for the back/
  # forward cache again and pressing Back is instant.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"
    Header unset Expires
    Header unset Pragma
  </FilesMatch>

  # ── Security ────────────────────────────────────────────────────────────
  #
  # `always`, not plain `set`, so these are sent on 403 and 404 responses too
  # — an error page is still a page an attacker can reach.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"

  # HSTS, one year, and deliberately WITHOUT includeSubDomains.
  #
  # This file governs the apex document root, but includeSubDomains binds
  # every present and future *.tokoacademy.org — learn, admin, app, and
  # anything not yet created. HSTS is the one header a browser remembers, so
  # a mistake cannot be withdrawn, only waited out. Narrow is correct here.
  # Not preloaded: that is a one-way door and belongs to whoever owns the
  # domain, not to a config file.
  Header always set Strict-Transport-Security "max-age=31536000"

  # ── Content Security Policy — reporting only, for now ───────────────────
  #
  # Report-Only reports violations without blocking, which is how a policy is
  # tested on a live site rather than on a hunch. Once the console is clean
  # across the home page, a course page, the contact form, a news article,
  # the gallery and zero2live, rename the header to Content-Security-Policy.
  # The value does not change.
  #
  # Three decisions worth knowing:
  #
  #   'unsafe-inline' in script-src is unavoidable. Next writes an inline
  #   hydration script into every exported page, and a static export has no
  #   server to mint a nonce and no stable hash to pin. Cloudflare's Rocket
  #   Loader, which is switched on, requires it independently.
  #
  #   img-src ends in a bare `https:` on purpose. Article images are pasted in
  #   by whoever writes the post, from whatever host — an allow-list would
  #   break a picture silently, weeks later, in an article nobody is looking
  #   at. `https:` still refuses plaintext images, which is the part that
  #   protects the page.
  #
  #   frame-ancestors and upgrade-insecure-requests are ignored while this is
  #   Report-Only, which is why X-Frame-Options above carries the clickjacking
  #   protection in the meantime.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://analytics.aictig.org https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://admin.tokoacademy.org https://analytics.aictig.org https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; media-src 'self'; upgrade-insecure-requests"
</IfModule>

# ── Shortlinks ──────────────────────────────────────────────────────────────
# Six-character codes resolve through /s/redirect.php. Carried over from the
# previous configuration because it is live: links of this shape are already
# printed and shared, and dropping the rule would break every one of them.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-zA-Z0-9]{6})$ /s/redirect.php?code=$1 [L]
</IfModule>

# Deliberately absent: the WordPress front-controller rewrite
# (`RewriteRule . /index.php [L]`) that sat at the end of the old file. There
# has been no WordPress here for some time and no index.php to route to, so
# every miss was rewritten to a file that does not exist. Misses now reach the
# 404 page above, which is a page rather than a server error.
